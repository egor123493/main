{
  "name": "cpp-dead-code-inspector",
  "displayName": "C++ Dead Code Inspector",
  "description": "Поиск недостижимых строк и неиспользуемых статических функций в C/C++.",
  "version": "0.0.1",
  "publisher": "student-placeholder",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:cpp",
    "onLanguage:c"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cppDeadCode.analyzeFile",
        "title": "C++ Dead Code Inspector: Analyze current file"
      },
      {
        "command": "cppDeadCode.analyzeWorkspace",
        "title": "C++ Dead Code Inspector: Analyze workspace"
      }
    ],
    "configuration": {
      "title": "C++ Dead Code Inspector",
      "properties": {
        "cppDeadCode.analyzeOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Анализировать C/C++ файл после сохранения."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.3.0"
  }
}